# --- Бот ---
BOT_TOKEN=123456:AAAA-your-bot-token
ADMINS=123456789                 # ID админов через запятую

# --- Юзербот (my.telegram.org -> API development tools) ---
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
SESSION=                         # заполняется автоматически: python -m anibot.setup

# --- Хранилище ---
STORAGE_CHANNEL=                 # заполняется автоматически (-100...)
CHANNEL_TITLE=Anime Storage

# --- Поведение ---
DATA_DIR=/var/lib/anime-bot
FREE_EPISODES=3                  # сколько серий бесплатно, 0 = всё платно
PROTECT_CONTENT=1                # запретить пересылку/сохранение выданного видео
AUTODELETE=0                     # удалять выданное видео через N минут, 0 = не удалять
DELIVERY=bot                     # bot | userbot — кто отдаёт видео
